# ─────────────────────────────────────────────────────────────────────────────
# medprom-metmal — Platform Media Promosi Tenant (Metmal Bekasi)
#
# Cara pakai: cp .env.example .env → isi nilai → jalankan server.
# Semua nilai di bawah placeholder — JANGAN dipakai produksi.
# Generate rahasia: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend (server/src/index.js) ─────────────────────────────────────────────
PORT=3001
# Postgres connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medprom
# Tanda tangan JWT — WAJIB ganti.
JWT_SECRET=ganti-jwt-secret-panjang-acak

# ── MID tenant roster (sama key dengan app event lama) ────────────────────────
MID_API_KEY=

# ── Media — Google Drive (akun mediapromosi.metmalbekasi@gmail.com) ──────────
# OAuth client dari console.cloud.google.com (Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Refresh token — produksi via: node scripts/drive-auth.mjs
GOOGLE_REFRESH_TOKEN=
# (Opsional) ID folder induk untuk file materi; kosong = root My Drive.
DRIVE_ROOT_FOLDER_ID=

# ── Captcha — Cloudflare Turnstile (gerbang endpoint pelacakan) ───────────────
# Widget captcha di halaman /lacak. Tanpa secret key, verifikasi server DILEWATI
# (dengan peringatan saat boot) — isi keduanya sebelum dipakai publik.
# Test key resmi Cloudflare (selalu lolos): sitekey 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA.
TURNSTILE_SECRET_KEY=
# Hostname frontend yang diizinkan memakai widget ini (dipisah koma). Wajib bila
# secret terisi — tanpa ini verifikasi DITOLAK (fail-closed). Produksi JANGAN
# memuat localhost/127.0.0.1. Contoh produksi: medprom-metmal.vercel.app
# Contoh dev: localhost,127.0.0.1
TURNSTILE_HOSTNAMES=

# ── CORS / cookie lintas-origin (produksi: Vercel FE → API domain sendiri) ────
# Daftar origin dipisah koma (exact-match). Contoh produksi:
# CORS_ORIGIN=https://medprom-metmal.vercel.app
CORS_ORIGIN=http://localhost:5173
# Produksi cross-site WAJIB: none + secure. Dev localhost: lax + false.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ── Frontend build (Vite) ─────────────────────────────────────────────────────
# Base URL REST tanpa suffix /api/v1 (rest.ts menambahkannya).
# Dev lokal: http://localhost:3001
# Produksi: https://promapi.metmalcommunityspace.web.id
# (domain lama promapi.andotherstori.my.id masih dilayani sebagai alias)
VITE_API_URL=http://localhost:3001

# Sitekey publik Cloudflare Turnstile (aman di-bundle). Kosong = widget captcha
# tidak dirender di halaman /lacak. Pasangannya: TURNSTILE_SECRET_KEY (server).
VITE_TURNSTILE_SITE_KEY=

# Petunjuk kredensial akun staf di halaman /login — TAHAP PENGEMBANGAN.
# Menyala bawaan (menampilkan email + password `admin123` ke siapa pun yang
# membuka /login). Set '0' sebelum dipakai publik, lalu build + deploy ulang.
VITE_PROMO_SHOW_DEV_LOGIN=
