# ─────────────────────────────────────────────────────────────────────────────
# medprom-metmal — VPS API — contoh konfigurasi lingkungan.
#
# Cara pakai: cp .env.example .env → isi nilai → docker compose up -d
# Semua nilai di bawah placeholder — JANGAN dipakai produksi.
# Generate rahasia: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_DB=medprom
POSTGRES_USER=medprom
POSTGRES_PASSWORD=ganti-password-db-yang-kuat

# ── Backend (api service) ────────────────────────────────────────────────────
# Koneksi dari dalam network Docker (host: postgres).
DATABASE_URL=postgres://medprom:ganti-password-db-yang-kuat@postgres:5432/medprom
# Rahasia JWT — WAJIB ganti: openssl rand -hex 32
JWT_SECRET=ganti-jwt-secret-panjang-acak

# ── CORS / cookie (FE di Vercel, API di subdomain VPS ini) ───────────────────
# Origin FE produksi — exact-match, dipisah koma bila lebih dari satu.
CORS_ORIGIN=https://medprom-metmal.vercel.app
# Cross-site cookie Vercel→API: WAJIB none + true.
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# ── MID tenant roster (opsional) ──────────────────────────────────────────────
# Key dari Metland (apiloyalty.metropolitanland.com). Kosong = pencarian gerai
# menolak dengan pesan "Konfigurasi server tidak lengkap" (fitur lain jalan).
MID_API_KEY=

# ── Media — Google Drive (akun mediapromosi.metmalbekasi@gmail.com) ──────────
# OAuth client dari console.cloud.google.com (Web application).
GOOGLE_CLIENT_ID=ganti-client-id-oauth
GOOGLE_CLIENT_SECRET=ganti-client-secret-oauth
# Refresh token — produksi via: node scripts/drive-auth.mjs (dari mesin lokal)
GOOGLE_REFRESH_TOKEN=ganti-refresh-token
# (Opsional) ID folder induk untuk file materi; kosong = root My Drive.
DRIVE_ROOT_FOLDER_ID=

# ── Captcha — Cloudflare Turnstile (opsional) ────────────────────────────────
# Secret key widget Turnstile (dashboard Cloudflare). Kosong = verifikasi
# captcha endpoint pelacakan /lacak DILEWATI (server menulis peringatan saat
# boot). Pasangannya VITE_TURNSTILE_SITE_KEY di env build frontend.
TURNSTILE_SECRET_KEY=
# Hostname frontend produksi (dipisah koma bila lebih dari satu). WAJIB bila
# secret terisi — tanpa ini verifikasi ditolak (fail-closed). Jangan sertakan
# localhost/127.0.0.1 di sini. Contoh: medprom-metmal.vercel.app
TURNSTILE_HOSTNAMES=
