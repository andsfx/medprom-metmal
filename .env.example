# ─────────────────────────────────────────────────────────────────────────────
# medprom-metmal — Platform Media Promosi Tenant (Metmal Bekasi)
#
# Cara pakai: cp .env.example .env → isi nilai → jalankan server.
# Semua nilai di bawah placeholder — JANGAN dipakai produksi.
# Generate rahasia: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend (server/src/index.js) ─────────────────────────────────────────────
PORT=3001
# Postgres connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medprom
# Tanda tangan JWT — WAJIB ganti.
JWT_SECRET=ganti-jwt-secret-panjang-acak

# ── MID tenant roster (sama key dengan app event lama) ────────────────────────
MID_API_KEY=

# ── Media — Cloudflare R2 (bucket terpisah dari metmal-gallery) ───────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=medprom-media
R2_PUBLIC_URL=

# ── CORS / cookie lintas-origin (produksi: Vercel FE → API domain sendiri) ────
# Daftar origin dipisah koma (exact-match). Contoh produksi:
# CORS_ORIGIN=https://medprom.vercel.app
CORS_ORIGIN=http://localhost:5173
# Produksi cross-site WAJIB: none + secure. Dev localhost: lax + false.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ── Frontend build (Vite) ─────────────────────────────────────────────────────
# Base URL REST tanpa suffix /api/v1 (rest.ts menambahkannya).
# Dev lokal: http://localhost:3001 — produksi: https://<api-domain>
VITE_API_URL=http://localhost:3001
